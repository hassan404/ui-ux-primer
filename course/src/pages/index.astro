---
import Base from '../layouts/Base.astro';

const withBase = (p: string) => (import.meta.env.BASE_URL + '/' + p).replace(/\/{2,}/g, '/');

const modules = [
  { n: 0, title: 'Why your UI looks off', meta: '8 min', href: '/modules/00-why-your-ui-looks-off/' },
  { n: 1, title: 'Hierarchy', meta: '15 min', href: '/modules/01-hierarchy/' },
  { n: 2, title: 'Space', meta: '12 min', href: '/modules/02-space/' },
  { n: 3, title: 'Type', meta: '10 min', href: '/modules/03-type/' },
  { n: 4, title: 'Color', meta: '10 min', href: '/modules/04-color/' },
  { n: 5, title: 'Depth & polish', meta: '10 min', href: '/modules/05-depth-and-polish/' },
  { n: 6, title: 'Behavior', meta: '12 min', href: '/modules/06-behavior/' },
  { n: 7, title: 'The mind on the other side', meta: '8 min', href: '/modules/07-the-mind/' },
  { n: 8, title: 'Judgement', meta: '15 min', href: '/modules/08-judgement/' },
  { n: 9, title: 'Reality', meta: '10 min', href: '/modules/09-reality/' },
  { n: 10, title: 'The exit drill', meta: 'scored, fresh items', href: '/exit/' },
  { n: 11, title: 'The checklist', meta: 'printable', href: '/checklist/' },
];
---
<Base
  title="UI/UX Primer for developers"
  description="A short interactive course that teaches developers sound UX judgement. Finite, drilled, no streaks."
>
  <div class="hero">
    <h1>You already know when a screen looks off.<br />Learn to see why. Then fix it.</h1>
    <p class="promise">
      A short course for developers. The judgement is the skill: where to look, what
      to check, which rule applies and when it doesn't. Ten modules train it, mostly
      by making you look.
    </p>
    <p class="facts">
      Ten modules, then a scored exit drill and a printable checklist. About ninety minutes
      of guided work, plus what you practice on your own screens. No signup, no
      streaks, no upsell. Every rule comes with its exceptions.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={withBase('/modules/00-why-your-ui-looks-off/')}>Start module 0</a>
      <span style="font-size: var(--t-1); color: var(--ink-3)">Eight minutes. That is the whole ask.</span>
    </div>
  </div>

  <ul class="map" aria-label="Course map">
    {modules.map((m) =>
      m.href ? (
        <li>
          <a class="row" href={withBase(m.href)}>
            <span class="num">{String(m.n).padStart(2, '0')}</span>
            <span class="name">{m.title}</span>
            <span class="meta">{m.meta}</span>
          </a>
        </li>
      ) : (
        <li class="queued">
          <div class="row">
            <span class="num">{String(m.n).padStart(2, '0')}</span>
            <span class="name">{m.title}</span>
            <span class="meta">queued</span>
          </div>
        </li>
      )
    )}
  </ul>

  <p class="footer-note">
    Built from <a href="https://github.com/hassan404/ui-ux-primer" target="_blank" rel="noopener">open research</a>.
    No module requires the ones after it.
  </p>
</Base>
