---
import Base from '../layouts/Base.astro';

const withBase = (p: string) => (import.meta.env.BASE_URL + '/' + p).replace(/\/{2,}/g, '/');

const modules = [
  { n: 0, title: 'Why your UI looks off', meta: '10 min', href: '/modules/00-why-your-ui-looks-off/' },
  { n: 1, title: 'Hierarchy', meta: '20 min', href: '/modules/01-hierarchy/' },
  { n: 2, title: 'Space', meta: '20 min', href: '/modules/02-space/' },
  { n: 3, title: 'Type', meta: '15 min', href: '/modules/03-type/' },
  { n: 4, title: 'Color', meta: '15 min', href: '/modules/04-color/' },
  { n: 5, title: 'Depth & polish', meta: '15 min', href: '/modules/05-depth-and-polish/' },
  { n: 6, title: 'Behavior', meta: '25 min', href: '/modules/06-behavior/' },
  { n: 7, title: 'The mind on the other side', meta: '20 min', href: '/modules/07-the-mind/' },
  { n: 8, title: 'Judgement', meta: '15 min', href: '/modules/08-judgement/' },
  { n: 9, title: 'Reality', meta: '15 min', href: '/modules/09-reality/' },
];
---
<Base
  title="UI/UX Primer for developers"
  description="A three-hour course that teaches developers sound UX judgement. Finite, interactive, no streaks."
>
  <div class="hero">
    <p class="kicker">a primer for developers</p>
    <h1>You already know when a screen looks off.<br />Learn to see why. Then fix it.</h1>
    <p class="promise">
      The judgement is the skill: where to look, what to check, which rule applies
      and when it doesn't. Ten short modules train it, mostly by making you look.
    </p>
    <ul class="facts">
      <li>10 modules</li>
      <li>~3 hours, total</li>
      <li>no signup · no streaks · no upsell</li>
      <li>every rule comes with its exceptions</li>
    </ul>
    <div class="cta-row">
      <a class="btn btn-primary" href={withBase('/modules/00-why-your-ui-looks-off/')}>Start module 0</a>
      <span style="font-size: var(--t-0); color: var(--ink-3); font-family: var(--mono)">10 minutes. That is the whole ask.</span>
    </div>
  </div>

  <ul class="map" aria-label="Course map">
    {modules.map((m) =>
      m.href ? (
        <li>
          <a class="row" href={withBase(m.href)}>
            <span class="num">{String(m.n).padStart(2, '0')}</span>
            <span class="name">{m.title}</span>
            <span class="meta">{m.meta}</span>
          </a>
        </li>
      ) : (
        <li class="queued">
          <div class="row">
            <span class="num">{String(m.n).padStart(2, '0')}</span>
            <span class="name">{m.title}</span>
            <span class="meta">queued</span>
          </div>
        </li>
      )
    )}
  </ul>

  <p class="footer-note">
    all ten modules are live, built from
    <a href="https://github.com/hassan404/ui-ux-primer">the research in this repo</a>.
    No module requires the ones after it.
  </p>
</Base>
