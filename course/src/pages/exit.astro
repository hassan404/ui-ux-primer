---
import Base from '../layouts/Base.astro';
import ExitDrill from '../components/ExitDrill.tsx';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base
  title="Exit drill · UI/UX Primer"
  description="Fourteen fresh spot-the-break trials across everything the course trained. Scored, so you know."
>
  <article>
    <header class="module-head">
      <p class="crumbs">After module 9</p>
      <h1>The exit drill</h1>
      <p class="dek">Fourteen trials, fresh each run. Reading about an eye is not the same as having one; this is where you find out, with a map for anything you miss.</p>
    </header>
    <div class="prose">
      <p>
        Every trial is a real layout with one family of tokens broken, by a random amount. Seven
        trials come from the course's own drill families. Five come from a rotating pool of surfaces
        no module showed you: a team list, a toolbar, a media card, a half-filled form. Two are
        wildcards. Levels, sides, order, and the rotation are fresh each run, so the only thing that
        can score well here is your perception. Twelve or more out of fourteen is a working eye;
        under nine, the score names the module to reread, which is better news than a certificate.
      </p>
      <ExitDrill client:visible base={base} />
    </div>
    <nav class="module-foot" aria-label="Navigation">
      <div>
        <a href={base + 'modules/09-reality/'}><span class="label">Previous</span>Reality</a>
      </div>
      <div style="text-align: right">
        <a href={base + 'checklist/'}><span class="label">Next</span>The checklist</a>
      </div>
    </nav>
  </article>
</Base>
